              "include_descendants",
              "source_incarnation",
              "work_ref",
              "work_field",
              "read_limit",
              "record_limit",
              "detail_limit"
            ],
            "additionalProperties": false
          },
          "maxItems": 10,
          "description": "Pass one request unchanged to review for a whole clipped field. Preserves the original root work scope and collection limits; retained evidence can become unavailable."
        }
      },
      "required": [
        "work_session_id",
        "availability",
        "fields",
        "field_refs",
        "truncated_fields"
      ],
      "additionalProperties": false
    },
    "correctness": {
      "type": "string",

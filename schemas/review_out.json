        "source_incarnation",
        "work_session_id",
        "field",
        "value"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "identity",
    "work_session_id",
    "source_incarnation",
    "scope",
    "coverage"
  ],
  "additionalProperties": false,
  "description": "Default compact view returns current_work, coverage/counts, up to five recent non-success diagnostics, selected evidence and explicit omission counts plus full_review_request. view=full preserves the prior aggregate fields. Exact result_ref returns detail only; neither view proves command/task correctness. Exact work_ref plus work_field returns only whole retained work-field detail and coverage."
}

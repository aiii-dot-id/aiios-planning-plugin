            "type": "boolean"
          },
          "result_detail_request": {
            "type": "object",
            "properties": {
              "work_session_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "source_incarnation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "result_ref": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "sequence": {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [

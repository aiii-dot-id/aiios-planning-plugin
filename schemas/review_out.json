                "additionalProperties": false,
                "description": "Stable work-notice RecordRef from the original review, not the transport ContentRef."
              },
              "work_field": {
                "type": "string",
                "enum": [
                  "state",
                  "focus",
                  "next_move",
                  "plan",
                  "expected_evidence",
                  "falsifier",
                  "decision_needed",
                  "result",
                  "evidence",
                  "evidence_readback"
                ]

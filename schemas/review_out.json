                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "id",
              "sequence",
              "sha256"
            ],
            "additionalProperties": false
          },
          "result_ref": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "sequence": {
                "type": "string",
                "pattern": "^[0-9]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "id",
              "sequence",
              "sha256"
            ],
            "additionalProperties": false
          },
          "result_excerpt": {
            "type": "string",
            "maxLength": 512,
            "description": "At most 256 runes for succeeded outcomes, otherwise 512. Long non-success text retains a prefix and tail separated by an explicit omitted-middle marker; use result_detail_request for bounded retained detail."
          },
          "result_record": {
            "type": "string"
